# ─────────────────────────────────────────────────────────────
# Notification service configuration
# Copy this file to ".env" and fill in real values.
# ─────────────────────────────────────────────────────────────

PORT=4005

# ── Email (Resend HTTP API) ─────────────────────────────────
# Preferred over SMTP below when set — goes over plain HTTPS, so it works
# on Render's free tier, which blocks outbound SMTP (ports 25/465/587)
# entirely as of Sept 2025 (https://render.com/changelog/free-web-services-will-no-longer-allow-outbound-traffic-to-smtp-ports).
# Get a free key at resend.com (3,000 emails/month, no card). Until you
# verify a sending domain there, Resend's sandbox mode only lets MAIL_FROM
# be "onboarding@resend.dev" and only delivers to the email address your
# Resend account itself is registered under — fine for testing, not for
# real patients.
RESEND_API_KEY=

# ── Email (SMTP) ────────────────────────────────────────────
# Sends REAL email through this SMTP account. Only usable locally or on a
# host that doesn't block outbound SMTP — set RESEND_API_KEY above instead
# for Render.
#
# Easiest options for testing:
#   1. Mailtrap (https://mailtrap.io) – a fake inbox, nothing reaches
#      real patients. Great for demos. Use the SMTP creds it gives you.
#   2. Gmail – create an "App Password" (Google Account > Security >
#      2-Step Verification > App passwords) and use it below.
#
# If these are left blank (and RESEND_API_KEY is also blank), the server
# still runs but "sends" emails to an Ethereal test account and prints a
# preview URL to the console.

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# The "From" address shown to patients
MAIL_FROM="Bright Smile Dental <no-reply@brightsmile.example>"

# ── SMS (Twilio) ────────────────────────────────────────────
# Sends REAL text messages through this Twilio account, for appointment
# confirmations, cancellations, follow-ups, and reminders.
#
# Auth is via the main Auth Token, not an API Key SID/Secret pair — Twilio
# API Keys require a paid account (a Trial account gets "This feature is
# not available on a Trial account" / error 20003 for any API key, even a
# correctly-copied one — see notification-service/src/sms.js). Switch back
# to API-key auth if/when the account is upgraded off Trial.
#
# Get these from the Twilio console (console.twilio.com):
#   - TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN: the Account dashboard's
#     "Account Info" panel — Auth Token is hidden by default, click to
#     reveal it. Neither has an "SK" prefix (that's API Keys, not this).
#   - TWILIO_FROM_NUMBER: a phone number your account owns (Phone Numbers >
#     Manage > Active Numbers — trial accounts get one free number). Must
#     be in E.164 format, e.g. +15551234567.
#
# If any of these are left blank, SMS sending is silently disabled — the
# app still runs and keeps sending confirmation/reminder EMAILS normally.
#
# Note: a Twilio TRIAL account can only send SMS to numbers you've
# verified in the console — real patient numbers won't receive SMS until
# the account is upgraded out of trial.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
