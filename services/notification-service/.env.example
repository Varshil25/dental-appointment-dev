# ─────────────────────────────────────────────────────────────
# Notification service configuration
# Copy this file to ".env" and fill in real values.
# ─────────────────────────────────────────────────────────────

PORT=4005

# ── Email (SMTP) ────────────────────────────────────────────
# Sends REAL email through this SMTP account.
#
# Easiest options for testing:
#   1. Mailtrap (https://mailtrap.io) – a fake inbox, nothing reaches
#      real patients. Great for demos. Use the SMTP creds it gives you.
#   2. Gmail – create an "App Password" (Google Account > Security >
#      2-Step Verification > App passwords) and use it below.
#
# If these are left blank, the server still runs but "sends" emails to
# an Ethereal test account and prints a preview URL to the console.

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# The "From" address shown to patients
MAIL_FROM="Bright Smile Dental <no-reply@brightsmile.example>"

# ── SMS (Twilio) ────────────────────────────────────────────
# Sends REAL text messages through this Twilio account, for appointment
# confirmations, cancellations, follow-ups, and reminders.
#
# Get these from the Twilio console (console.twilio.com):
#   - TWILIO_ACCOUNT_SID / TWILIO_AUTH_TOKEN: Account dashboard.
#   - TWILIO_FROM_NUMBER: a phone number your account owns (Phone Numbers >
#     Manage > Active Numbers — trial accounts get one free number). Must
#     be in E.164 format, e.g. +15551234567.
#
# If any of these are left blank, SMS sending is silently disabled — the
# app still runs and keeps sending confirmation/reminder EMAILS normally.
#
# Note: a Twilio TRIAL account can only send SMS to numbers you've
# verified in the console — real patient numbers won't receive SMS until
# the account is upgraded out of trial.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
