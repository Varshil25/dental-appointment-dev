# Copy to ".env" and adjust for local dev / Render.

PORT=4003

# Neon Postgres connection string for this service's own database
# (create a dedicated database, e.g. "appointment_service", inside your
# Neon project — don't share one database across services).
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/appointment_service?sslmode=require

PATIENT_SERVICE_URL=http://localhost:4001
DENTIST_SERVICE_URL=http://localhost:4002
REMINDER_SERVICE_URL=http://localhost:4004
NOTIFICATION_SERVICE_URL=http://localhost:4005

# Optional read-through cache — leave blank to run without Redis (this
# service works identically either way, just without the speed boost).
REDIS_URL=

# Clinic display info (used in booking/cancellation/follow-up emails)
CLINIC_NAME=Bright Smile Dental
CLINIC_PHONE=(555) 012-3456
CLINIC_ADDRESS=12 Riverside Ave, Springfield

# Shared secret required on the header X-Seed-Token to hit
# POST /internal/appointments/seed (used only by scripts/seed-all.js).
SEED_TOKEN=dev-seed-token
