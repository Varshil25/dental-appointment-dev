# Copy to ".env" and adjust for local dev / Render.

PORT=4007

# Neon Postgres connection string for this service's own database
# (create a dedicated database, e.g. "auth_service", inside your Neon
# project — don't share one database across services).
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/auth_service?sslmode=require

# Signs and verifies JWTs. MUST be the exact same value as the gateway's
# JWT_SECRET (services/gateway/.env) — the gateway verifies tokens this
# service issues without calling back here, so a mismatch makes every
# login look invalid at the gateway. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=dev-only-change-me

# How long an access token stays valid. Password-reset session invalidation
# (see reset-password) only takes effect the next time the frontend calls
# GET /api/auth/me — a shorter expiry bounds how long a token can outlive
# that check.
JWT_EXPIRES_IN=8h

# Cross-service validation of dentist_id when creating a doctor account —
# same pattern appointment-service uses to validate patient_id/dentist_id.
DENTIST_SERVICE_URL=http://localhost:4002

# Where OTP and password-reset emails actually get sent from.
NOTIFICATION_SERVICE_URL=http://localhost:4005

# Used to build the link inside password-reset emails
# (${FRONTEND_URL}/reset-password?token=...&ref=...). The admin dashboard
# is served under /v1/admin off the single dev-proxy origin (port 3000,
# see scripts/dev-proxy.js) rather than its own port, so this must include
# that path.
FRONTEND_URL=http://localhost:3000/v1/admin

# Clinic display info (used in OTP/reset emails).
CLINIC_NAME=Bright Smile Dental
CLINIC_PHONE=(555) 012-3456
CLINIC_ADDRESS=12 Riverside Ave, Springfield

# Shared secret required on the header X-Seed-Token to hit
# POST /internal/seed-user (used only by scripts/seed-all.js to create the
# first admin/doctor accounts — same pattern as appointment-service's
# SEED_TOKEN). Must match SEED_TOKEN in services/appointment-service/.env
# only if you want one token across both; they're independent otherwise.
SEED_TOKEN=dev-seed-token
