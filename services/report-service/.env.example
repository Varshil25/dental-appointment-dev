# Copy to ".env" and adjust for local dev / Render.

PORT=4006

PATIENT_SERVICE_URL=http://localhost:4001
DENTIST_SERVICE_URL=http://localhost:4002
APPOINTMENT_SERVICE_URL=http://localhost:4003
REMINDER_SERVICE_URL=http://localhost:4004

# Optional read-through cache — leave blank to run without Redis (this
# service works identically either way, just without the speed boost).
# Caches the whole composed /summary response (the most expensive
# operation in the backend — 5 parallel calls + composition).
REDIS_URL=

# Clinic display info (used in the PDF report header/footer)
CLINIC_NAME=Bright Smile Dental
CLINIC_PHONE=(555) 012-3456
CLINIC_ADDRESS=12 Riverside Ave, Springfield
