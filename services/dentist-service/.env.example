# Copy to ".env" and adjust for local dev / Render.

PORT=4002

# Neon Postgres connection string for this service's own database
# (create a dedicated database, e.g. "dentist_service", inside your Neon
# project — don't share one database across services).
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/dentist_service?sslmode=require

# Where appointment-service lives — used to check taken slots.
APPOINTMENT_SERVICE_URL=http://localhost:4003

# Optional read-through cache — leave blank to run without Redis (this
# service works identically either way, just without the speed boost).
REDIS_URL=

# Used only to seed the one-time default clinic_profile row on first boot
# (see db.js) — after that, the row in Postgres is the source of truth and
# these env vars are ignored. Edit clinic settings via PUT /api/clinic-profile
# (or the Clinic Settings admin page) instead.
CLINIC_NAME=Bright Smile Dental
CLINIC_PHONE=(555) 012-3456
CLINIC_ADDRESS=12 Riverside Ave, Springfield
