# Copy to ".env" and adjust for local dev / Render.

PORT=4000

PATIENT_SERVICE_URL=http://localhost:4001
DENTIST_SERVICE_URL=http://localhost:4002
APPOINTMENT_SERVICE_URL=http://localhost:4003
REMINDER_SERVICE_URL=http://localhost:4004
REPORT_SERVICE_URL=http://localhost:4006
AUTH_SERVICE_URL=http://localhost:4007

# Verifies JWTs issued by auth-service directly (see src/auth.js for why
# this gateway does that itself rather than calling auth-service on every
# request). MUST be the exact same value as auth-service's JWT_SECRET
# (services/auth-service/.env) — a mismatch makes every login look invalid
# here even though auth-service issued it correctly.
JWT_SECRET=dev-only-change-me

CLINIC_NAME=Bright Smile Dental

# Powers POST /api/chat (the patient-frontend chat widget). Get a key from
# aistudio.google.com/apikey. Leave blank in an environment that shouldn't
# run the chatbot — the endpoint 503s cleanly instead of crashing the
# gateway. Never exposed to the frontend; only this server-side proxy reads
# it.
GEMINI_API_KEY=
