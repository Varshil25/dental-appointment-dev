# Copy to ".env" and adjust for local dev / Render.

PORT=4004

# Neon Postgres connection string for this service's own database
# (create a dedicated database, e.g. "reminder_service", inside your Neon
# project — don't share one database across services).
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/reminder_service?sslmode=require

# Where the actual email delivery happens.
NOTIFICATION_SERVICE_URL=http://localhost:4005

# Optional read-through cache — leave blank to run without Redis (this
# service works identically either way, just without the speed boost).
REDIS_URL=

# Comma-separated hours-before-appointment to send reminders.
REMINDER_OFFSETS_HOURS=48,2

# How often (cron expression) to scan for due reminders. Default: every minute.
REMINDER_CRON=* * * * *

# Clinic display info (used in reminder emails)
CLINIC_NAME=Bright Smile Dental
CLINIC_PHONE=(555) 012-3456
CLINIC_ADDRESS=12 Riverside Ave, Springfield
